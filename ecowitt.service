[Unit]
Description=Ecowitt to InfluxDB Listener
# Bei Bindung an eine VPN-IP (ECOWITT_HOST) die Schnittstelle abwarten, z. B.
# After=network-online.target wg-quick@wg0.service
After=network-online.target
Wants=network-online.target

[Service]
User=stefan
WorkingDirectory=/opt/ecowitt
EnvironmentFile=/etc/ecowitt/config.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ecowitt/ecowitt_to_influxdb.py
# Automatisch neu starten bei Absturz
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
