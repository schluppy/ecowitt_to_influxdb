# /etc/ecowitt/config.env - wird von ecowitt.service per EnvironmentFile geladen
# Rechte: root:<dienstuser> 640. Nie ins Git committen.

# Passkey der Konsole: MD5 der MAC-Adresse (Großbuchstaben, mit Doppelpunkten)
ECOWITT_PASSKEY=
# Port, auf dem die Konsole sendet (WS View Plus -> Customized)
ECOWITT_PORT=8090
# true = jedes Paket ins Journal (ohne PASSKEY), nur zur Fehlersuche
ECOWITT_DEBUG=false

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=Bergkoppel
INFLUX_BUCKET=wetterstation
